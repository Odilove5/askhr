# Copy to .env (gitignored) and fill in. Never commit .env.

# Local model (Ollama)
ASKHR_OLLAMA_MODEL=hf.co/unsloth/gemma-4-12b-it-GGUF:UD-Q5_K_XL
ASKHR_OLLAMA_BASE_URL=http://localhost:11434

# Cloud model (Claude API). Off by default: it is the kill switch.
ASKHR_CLOUD_ENABLED=false
ASKHR_ANTHROPIC_API_KEY=
